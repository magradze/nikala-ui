{
  "name": "nikala-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:registry": "cd packages/core && bun run build:registry",
    "build:cli": "cd packages/cli && bun run build",
    "build:web": "cd apps/web && bun run build",
    "build": "bun run build:registry && bun run build:cli && bun run build:web"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.2"
  }
}