{
  "name": "nikala-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:registry": "bun --filter '@nikala-ui/core' run build:registry",
    "build:cli": "bun --filter '@nikala-ui/cli' run build",
    "build:web": "bun --filter 'nikala-web' run build",
    "build": "bun run build:registry && bun run build:cli && bun run build:web"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.2"
  }
}