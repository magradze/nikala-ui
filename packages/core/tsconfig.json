{
  "compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@/*": ["./src/*"]
		},
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "scripts/**/*"]
}