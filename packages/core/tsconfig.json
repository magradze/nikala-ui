{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@/components/ui/*": ["./src/registry/components/ui/*"],
      "@/components/blocks/*": ["./src/registry/blocks/*"],
      "@/hooks/*": ["../hooks/src/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "scripts/**/*"]
}