{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@/components/ui/*": ["../core/src/registry/components/ui/*"],
      "@/hooks/*": ["../hooks/src/*"],
      "@/lib/*": ["../core/src/lib/*"],
      "@/providers/*": ["../core/src/registry/providers/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
