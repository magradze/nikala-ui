{
  "name": "@nikala-ui/docs",
  "version": "0.11.0",
  "description": "Zero-config, fast, and elegant documentation engine for SolidJS, built on Nikala UI and Tailwind CSS v4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nikala-docs": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikala-ui/ui.git",
    "directory": "packages/docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "@mdx-js/mdx": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@nikala-ui/core": "workspace:*",
    "@nikala-ui/hooks": "workspace:*",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.6",
    "gray-matter": "^4.0.3",
    "lucide-solid": "^1.28.0",
    "picocolors": "^1.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "tailwindcss": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
